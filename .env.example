# ═══════════════════════════════════════════════════════════════════════
# PUMPRADAR — Texas Big Trader AutoChat
# ═══════════════════════════════════════════════════════════════════════

# ─── Telegram ───────────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Your chat ID — message @userinfobot to find it
TELEGRAM_CHAT_ID=

# ─── Solana Wallet ──────────────────────────────────────────────────────────
# Your operator bot wallet — use a DEDICATED wallet, not your main one
# Fund it with ~0.1 SOL for gas
PRIVATE_KEY=

# ─── YOUR Contact Info ──────────────────────────────────────────────────────
# Tell devs to reach you at these — what YOU want them to message
# No @ symbol needed — just the username/handle
# These get sent to devs in the pump.fun chat
PUMPRADAR_TG_USERNAME=TradeSignals
PUMPRADAR_X_USERNAME=TradeSignalsX
PUMPRADAR_DISCORD_USERNAME=TradeSignals#1234

# ─── Ollama (FREE local AI) ─────────────────────────────────────────────────
# Optional — if not set, uses template-based conversation
# Install:  curl -fsSL https://ollama.com/install.sh | sh
# Pull:     ollama pull llama3.2:3b
# Start:    ollama serve   (runs on localhost:11434)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─── Birdeye ────────────────────────────────────────────────────────────────
BIRDEYE_API_KEY=
