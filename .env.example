# ─── WalletConnect Project ID ────────────────────────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=0eb56d36858aa49715ce9a72d2d46d39

# ─── Moralis API Key ──────────────────────────────────────────────────────────
MORALIS_API_KEY=

# ─── Telegram bot — REQUIRED for AutoChat alerts & approval buttons ────────
# Get from @BotFather. Used for both alert-send and Approve/Skip buttons.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Solana PRIVATE KEY ────────────────────────────────────────────────────
# OPTIONAL. The bot operator key is normally set in the Settings UI
# (Settings → Wallet tab → "Save Key & Sync").
# Use a DEDICATED wallet you create just for the bot. Fund it with ~0.1 SOL.
PRIVATE_KEY=

# ─── Ollama AI (FREE — local) ───────────────────────────────────────────────
# Optional. Ollama generates smart Texas trader responses using free local AI.
# If not set, falls back to template-based responses.
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull model:  ollama pull llama3.2:3b
# Start:       ollama serve (runs on localhost:11434)
# Recommended models: llama3.2:3b (fast, ~2GB), llama3.1:8b (smarter, ~5GB)
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─── Birdeye API key ─────────────────────────────────────────────────────────
BIRDEYE_API_KEY=

# ─── VAPID keys — browser push notifications ────────────────────────────────
# Generate once with: node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@pumpradar.app
